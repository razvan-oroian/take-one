<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" stylesheets="@/css/theme.css"
      minWidth="900.0" minHeight="900.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.MovieInfoController">    <padding>
        <Insets bottom="20" left="40" right="40" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button onAction="#handleBack" style="-fx-font-size: 18px; -fx-font-weight: bold;" styleClass="icon-button" text="Back" textFill="#797979">
         <font>
            <Font size="11.0" />
         </font></Button>
        <HBox alignment="CENTER" spacing="10">
            <Label styleClass="logo-text" text="Take One" />
            <ImageView fitHeight="50.0" preserveRatio="true" translateY="-5.0">
                <image>
                    <Image url="@/images/logo.png" />
                </image>
            </ImageView>
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="10">
            <Button onAction="#goToWatchlist" styleClass="icon-button" text="📋" style="-fx-font-size: 24px;" />                    <Button styleClass="icon-button" text="👤" style="-fx-font-size: 24px;" />
        </HBox>
    </HBox>

    <GridPane hgap="40.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="35.0" minWidth="0" />
            <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" percentWidth="65.0" minWidth="0" />
        </columnConstraints>

        <rowConstraints>
            <RowConstraints valignment="TOP" vgrow="ALWAYS" />
        </rowConstraints>

        <VBox alignment="TOP_CENTER" spacing="20.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <StackPane fx:id="posterContainer" maxWidth="-Infinity">
                <ImageView fx:id="moviePosterImage" fitWidth="200.0" preserveRatio="true">
                    <Image url="https://image.tmdb.org/t/p/w500/2u7zLwG07O3giZ8YhAW3gmg6CgY.jpg" />
                </ImageView>
                <ImageView fx:id="movieBorderImage" fitHeight="350.0" fitWidth="250.0" pickOnBounds="false">
                    <Image url="@/images/movie-border.png" />
                </ImageView>
            </StackPane>
            <Button fx:id="watchlistButton" onAction="#handleToggleWatchlist" styleClass="filter-button" text="+ WATCHLIST" minWidth="200.0" prefWidth="200.0" maxWidth="200.0" alignment="CENTER" />            <VBox alignment="TOP_LEFT" maxWidth="250.0" spacing="8.0">
            <Label fx:id="movieTitleLabel" style="-fx-font-family: 'Impact', sans-serif; -fx-font-size: 24px; -fx-text-fill: black;" text="THE EMPIRE STRIKES BACK" wrapText="true" minWidth="0" prefWidth="250.0" />
            <Label fx:id="releaseDateLabel" style="-fx-font-family: 'Helvetica', sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="RELEASE DATE: 21 MAY 1980" />
                <Label fx:id="runtimeLabel" style="-fx-font-family: 'Helvetica', sans-serif; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="RUNTIME: 124 MIN" />
            </VBox>



        </VBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" GridPane.columnIndex="1">
            <VBox spacing="30.0" style="-fx-padding: 0 20 0 0;">

                <VBox spacing="8.0">
                    <Label style="-fx-font-family: 'Impact', sans-serif; -fx-font-size: 24px; -fx-text-fill: white;" text="OVERVIEW" />
                    <Label fx:id="overviewTextLabel" style="-fx-font-family: 'Arial', sans-serif; -fx-font-size: 16px; -fx-text-fill: black; -fx-line-spacing: 5px;" text="After the Rebels are brutally overpowered by the Empire on the ice planet Hoth, Luke Skywalker begins Jedi training with Yoda, while his friends are pursued by Darth Vader and a bounty hunter named Boba Fett across the galaxy." wrapText="true" />
                </VBox>


                <VBox spacing="8.0">
                    <Label style="-fx-font-family: 'Impact', sans-serif; -fx-font-size: 24px; -fx-text-fill: white;" text="DIRECTOR" />

                    <VBox alignment="TOP_LEFT" spacing="8.0">
                        <ImageView fx:id="directorImage" fitHeight="180.0" preserveRatio="true">
                            <Image url="https://image.tmdb.org/t/p/w185/676fK89q44mQ4ZidM8wAs99V77p.jpg" />
                        </ImageView>
                        <Label fx:id="directorNameLabel" style="-fx-font-family: 'Arial', sans-serif; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;" text="Irvin Kershner" />
                    </VBox>
                </VBox>

                <VBox spacing="12.0">
                    <Label style="-fx-font-family: 'Impact', sans-serif; -fx-font-size: 24px; -fx-text-fill: white;" text="CAST" />
                    <FlowPane alignment="TOP_LEFT" hgap="30.0" vgap="20.0">

                        <VBox alignment="TOP_CENTER" spacing="6.0">
                            <ImageView fx:id="actor1Image" fitHeight="180.0" preserveRatio="true">
                                <Image url="https://image.tmdb.org/t/p/w185/clG766Spv687wJ67v6py0gLVgA2.jpg" />
                            </ImageView>
                            <Label fx:id="actor1Label" style="-fx-font-family: 'Arial', sans-serif; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;" text="Mark Hamill" />
                            <Label fx:id="role1Label" style="-fx-font-family: 'Arial', sans-serif; -fx-font-size: 12px; -fx-text-fill: #333333;" text="Luke Skywalker" />
                        </VBox>

                        <VBox alignment="TOP_CENTER" spacing="6.0">
                            <ImageView fx:id="actor2Image" fitHeight="180.0" preserveRatio="true">
                                <Image url="https://image.tmdb.org/t/p/w185/5g931j9NUn48356vY6gY8W6Ch4g.jpg" />
                            </ImageView>
                            <Label fx:id="actor2Label" style="-fx-font-family: 'Arial', sans-serif; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;" text="Harrison Ford" />
                            <Label fx:id="role2Label" style="-fx-font-family: 'Arial', sans-serif; -fx-font-size: 12px; -fx-text-fill: #333333;" text="Han Solo" />
                        </VBox>

                        <VBox alignment="TOP_CENTER" spacing="6.0">
                            <ImageView fx:id="actor3Image" fitHeight="180.0" preserveRatio="true">
                                <Image url="https://image.tmdb.org/t/p/w185/7w06gn68uUOLw7w6SgnCO99uY8Y.jpg" />
                            </ImageView>
                            <Label fx:id="actor3Label" style="-fx-font-family: 'Arial', sans-serif; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;" text="Carrie Fisher" />
                            <Label fx:id="role3Label" style="-fx-font-family: 'Arial', sans-serif; -fx-font-size: 12px; -fx-text-fill: #333333;" text="Princess Leia" />
                        </VBox>

                    </FlowPane>
                </VBox>

                <VBox spacing="15.0" style="-fx-padding: 20 0 20 0; -fx-background-color: transparent;">
                    <Label style="-fx-font-family: 'Impact', sans-serif; -fx-font-size: 24px; -fx-text-fill: white;" text="MY REVIEW" />

                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="Rating:" minWidth="-Infinity"/>

                        <HBox fx:id="starRatingBox" spacing="2.0" alignment="CENTER_LEFT" minWidth="-Infinity"/>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="saveReviewButton" onAction="#handleSaveReview" styleClass="filter-button" text="SAVE" style="-fx-cursor: hand" minWidth="-Infinity" prefWidth="100.0"/>
                    </HBox>

                    <TextArea fx:id="reviewTextArea" prefRowCount="3" wrapText="true" promptText="What did you think of the movie? (Optional)"
                              style="-fx-control-inner-background: #2b2b2b; -fx-text-fill: white; -fx-prompt-text-fill: gray; -fx-font-size: 14px; -fx-background-radius: 5;" />

                    <Label fx:id="reviewStatusLabel" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;" visible="false" />
                </VBox>

            </VBox>
        </ScrollPane>
    </GridPane>
</VBox>
