<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" stylesheets="@/css/theme.css"
      minWidth="900.0" minHeight="650.0" style="-fx-background-color: #FA5E5B;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.WatchlistController">

    <padding>
        <Insets bottom="20" left="40" right="40" top="20" />
    </padding>

    <BorderPane>
        <left>
            <Button onAction="#handleBack" styleClass="icon-button" text="Back" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: black;" BorderPane.alignment="CENTER"/>
        </left>
        <center>
            <HBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
                <Label styleClass="logo-text" text="Take One" style="-fx-text-fill: black;" />
                <ImageView fitHeight="50.0" preserveRatio="true" translateY="-5.0">
                    <Image url="@/images/logo.png" />
                </ImageView>
            </HBox>
        </center>
        <right>
            <HBox spacing="10" alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
                <Button styleClass="icon-button" text="📋" style="-fx-font-size: 24px;" />
                <Button onAction="#goToProfile" styleClass="icon-button" text="👤" style="-fx-font-size: 24px;"/>
            </HBox>
        </right>
    </BorderPane>

    <Label style="-fx-font-family: 'Impact'; -fx-font-size: 36px; -fx-text-fill: white;" text="WATCHLIST" />

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <VBox fx:id="watchlistContainer" spacing="0" />
    </ScrollPane>
</VBox>