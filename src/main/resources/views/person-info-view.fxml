<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" stylesheets="@/css/theme.css"
      minWidth="900.0" minHeight="650.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.PersonInfoController">
    <padding>
        <Insets bottom="20" left="40" right="40" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Button onAction="#handleBack" style="-fx-font-size: 18px; -fx-font-weight: bold;"
                styleClass="icon-button" text="Back" textFill="#797979">
            <font><Font size="11.0" /></font>
        </Button>
        <HBox alignment="CENTER" spacing="10">
            <Label styleClass="logo-text" text="Take One" />
            <ImageView fitHeight="50.0" preserveRatio="true" translateY="-5.0">
                <Image url="@/images/logo.png" />
            </ImageView>
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="10">
            <Button onAction="#goToWatchlist" styleClass="icon-button" text="📋" style="-fx-font-size: 24px;" />                    <Button styleClass="icon-button" text="👤" style="-fx-font-size: 24px;" />
        </HBox>
    </HBox>

    <GridPane hgap="40.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="30.0" />
            <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" percentWidth="70.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints valignment="TOP" vgrow="ALWAYS" />
        </rowConstraints>

        <VBox alignment="TOP_CENTER" spacing="15.0" GridPane.columnIndex="0">
            <ImageView fx:id="profileImage" fitWidth="220.0" preserveRatio="true">
                <Image url="https://image.tmdb.org/t/p/w500/clG766Spv687wJ67v6py0gLVgA2.jpg" backgroundLoading="true"/>
            </ImageView>

            <VBox alignment="TOP_CENTER" spacing="5.0">
                <Label fx:id="nameLabel" style="-fx-font-family: 'Impact', sans-serif; -fx-font-size: 28px; -fx-text-fill: black;" text="MARK HAMILL" wrapText="true" textAlignment="CENTER"/>
                <Label fx:id="birthDateLabel" style="-fx-font-family: 'Helvetica', sans-serif; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555555;" text="BORN: 25 SEP 1951" />
            </VBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" GridPane.columnIndex="1">
            <VBox spacing="30.0">

                <VBox spacing="8.0">
                    <Label style="-fx-font-family: 'Impact', sans-serif; -fx-font-size: 24px; -fx-text-fill: white;" text="BIOGRAPHY" />

                    <ScrollPane fitToWidth="true" prefHeight="300.0" style="-fx-background-color: transparent; -fx-background: transparent;">

                        <Label fx:id="biographyLabel" style="-fx-font-family: 'Arial', sans-serif; -fx-font-size: 16px; -fx-text-fill: black; -fx-line-spacing: 5px;" text="Loading biography..." wrapText="true" />

                    </ScrollPane>
                </VBox>
                <VBox spacing="12.0">
                    <Label style="-fx-font-family: 'Impact', sans-serif; -fx-font-size: 24px; -fx-text-fill: white;" text="KNOWN FOR" />
                    <TilePane fx:id="movieGrid" alignment="TOP_LEFT" hgap="20.0" vgap="20.0" prefColumns="4">
                    </TilePane>
                </VBox>

            </VBox>
        </ScrollPane>
    </GridPane>
</VBox>
