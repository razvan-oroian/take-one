<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" stylesheets="@/css/theme.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SearchController">
    <padding>
        <Insets bottom="20" left="40" right="40" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <HBox alignment="CENTER" spacing="10">
            <Label styleClass="logo-text" text="Take One" />
            <ImageView fitHeight="50.0" preserveRatio="true" translateY="-5.0">
                <image>
                    <Image url="@/images/logo.png" />
                </image>
            </ImageView>
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="10">
            <Button onAction="#goToWatchlist" styleClass="icon-button" text="📋" style="-fx-font-size: 24px;" />                    <Button styleClass="icon-button" text="👤" style="-fx-font-size: 24px;" />
        </HBox>
    </HBox>

    <VBox spacing="10">
        <TextField fx:id="searchField" onKeyReleased="#handleSearch" promptText="Search movies..." styleClass="search-bar" />
        <HBox alignment="CENTER_RIGHT" spacing="15">
            <ComboBox fx:id="runtimeFilter" promptText="RUNTIME" styleClass="filter-button" />
            <ComboBox fx:id="periodFilter" promptText="PERIOD" styleClass="filter-button" />
            <ComboBox fx:id="genreFilter" promptText="GENRE" styleClass="filter-button" />
        </HBox>
    </VBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <TilePane fx:id="movieGrid" alignment="TOP_LEFT" hgap="30" prefColumns="5" vgap="30">
        </TilePane>
    </ScrollPane>
</VBox>
