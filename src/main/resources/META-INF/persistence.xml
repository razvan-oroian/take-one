<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

<persistence-unit name="myPersistenceUnit">
    <class>model.User</class>
    <class>model.Movie</class>
    <class>model.Actor</class>
    <class>model.Director</class>
    <class>model.Review</class>
    <class>model.Genre</class>
    <class>model.Casting</class>
    <class>model.WatchlistEntry</class>

    <properties>
        <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/TakeOne"/>
        <property name="jakarta.persistence.jdbc.user" value="POSTGRES_USERNAME_HERE"/>
        <property name="jakarta.persistence.jdbc.password" value="POSTGRES_PASSWORD_HERE"/>
        <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

        <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
        <property name="hibernate.show_sql" value="true"/>
        <property name="hibernate.format_sql" value="true"/>
        <property name="hibernate.hbm2ddl.auto" value="update"/>
    </properties>
</persistence-unit>
</persistence>